{
  "ConnectionStrings": {
    "Default": ""
  },

  "Jwt": {
    "Issuer": "https://ecommerceplatform.local",
    "Audience": "ecommerceplatform.api",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "ClockSkewSeconds": 30
  },

  "Session": {
    "MaxActiveSessionsPerUser": 5,
    "ValidateSessionPerRequest": true
  },

  "FileStorage": {
    "RootPath": "Uploads",
    "PublicBaseUrl": "/uploads",
    "MaxFileSizeMb": 5
  },

  "Seed": {
    "AdminEmail": ""
  },

  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "SenderName": "HarborSure",
    "SenderEmail": "",
    "Username": "",
    "AppPassword": ""
  },

  "Payment": {
    "AllowClientManualConfirm": false,
    "Razorpay": {
      "KeyId": "",
      "KeySecret": "",
      "WebhookSecret": ""
    }
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },

    "Enrich": [
      "FromLogContext"
    ],

    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {RequestId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ecommerceplatform-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 52428800,
          "shared": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },

  "AllowedHosts": "*"
}
